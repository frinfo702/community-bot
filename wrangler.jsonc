{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "containers": [
    {
      "class_name": "SandboxContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DISCORD_GATEWAY", "class_name": "GatewayDO" },
      { "name": "DEDUPE", "class_name": "DedupeDO" },
      { "name": "CONVERSATION", "class_name": "ConversationDO" },
      { "name": "SANDBOX", "class_name": "SandboxContainer" },
      { "name": "TASK_AGENT", "class_name": "TaskAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayDO", "DedupeDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ConversationDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SandboxContainer"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["TaskAgent"]
    }
  ]
}
