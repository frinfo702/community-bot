{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "DISCORD_GATEWAY", "class_name": "GatewayDO" },
      { "name": "DEDUPE", "class_name": "DedupeDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayDO", "DedupeDO"]
    }
  ]
}
