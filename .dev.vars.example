# コピーして .dev.vars にする（このファイルはコミットしない）
# 本番は `npx wrangler secret put <NAME>` で登録する

# Discord（docs/discord-setup.md 参照）
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Gateway DO と Worker の間の共有シークレット（任意のランダム文字列）
DISCORD_GATEWAY_SECRET=dev-gateway-secret
# /connect /disconnect /status を保護する管理用シークレット
ADMIN_SECRET=dev-admin-secret

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
# 変更する場合のみ
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# TypeSafe Jev（判断モデル）
JEV_API_KEY=
# 変更する場合のみ
JEV_BASE_URL=https://api.typesafe.ai/v1

# Jina（task エージェントの web_search / read_page）
JINA_API_KEY=
# 変更する場合のみ
JINA_SEARCH_URL=https://s.jina.ai/
JINA_READER_URL=https://r.jina.ai/

# モデルID（既定は src/models.ts。上書きするときだけ設定する）
CHAT_MODEL=
IMAGE_MODEL=
DECIDE_MODEL=
