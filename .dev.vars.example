# Copy to .dev.vars (this file is not committed)
# Register production values with `npx wrangler secret put <NAME>`

# Discord (see docs/discord-setup.md)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Shared secret between the Gateway DO and the Worker (any random string)
DISCORD_GATEWAY_SECRET=dev-gateway-secret
# Admin secret that protects /connect /disconnect /status
ADMIN_SECRET=dev-admin-secret

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
# Only change if needed
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# TypeSafe Jev (decision model)
JEV_API_KEY=
# Only change if needed
JEV_BASE_URL=https://api.typesafe.ai/v1

# Jina (web_search / read_page for the task agent)
JINA_API_KEY=
# Only change if needed
JINA_SEARCH_URL=https://s.jina.ai/
JINA_READER_URL=https://r.jina.ai/

# Model IDs (defaults in src/models.ts; set only to override)
CHAT_MODEL=
DECIDE_MODEL=
